{
    "extends": "@tsconfig/strictest",
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "rootDir": "./",
        "noEmit": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "@/*": ["./src/*"]
        },
        "types": ["bun", "@cloudflare/workers-types"]
    },
    "include": ["./src/**/*", "./*.ts"]
}
